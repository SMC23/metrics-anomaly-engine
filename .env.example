# Copy to .env for local development. Do not commit .env.

# Application
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://metrics:change-me-dev-only@localhost:5432/metrics
STREAM_PARTITIONS=1
STREAM_MAXLEN=1000000
# Comma-separated partition numbers owned by this worker, for example 0 or 0,1.
WORKER_PARTITIONS=0
WINDOW_SIZE=60
IFOREST_EVAL_EVERY=10
MODEL_PATH=models/iforest.joblib
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:8080
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# TimescaleDB container (Docker Compose only). Must match DATABASE_URL.
POSTGRES_USER=metrics
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=metrics
